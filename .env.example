# Copy to .env and adjust. All values also settable in config/config.yaml;
# environment variables take precedence (prefix: UNINET_).

UNINET_BUS=inproc                 # inproc | kafka
UNINET_KAFKA_BROKERS=localhost:9092
UNINET_KAFKA_TOPIC=uninet.flows.oneway

UNINET_WINDOW_SECONDS=60          # feature/graph processing window
UNINET_BURST_GAP_SECONDS=2.0      # idle gap that ends a traffic burst
UNINET_ALERT_THRESHOLD=0.5        # min fused confidence to raise an alert

UNINET_MODEL_DIR=models
UNINET_API_HOST=127.0.0.1
UNINET_API_PORT=8000

# Dashboard login (single operator account)
UNINET_AUTH_DISABLED=0            # 1 = no login screen (local dev only)
UNINET_AUTH_USER=admin
UNINET_AUTH_PASSWORD=uninet
UNINET_SECRET_KEY=uninet-dev-secret-change-me
